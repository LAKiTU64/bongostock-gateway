[Unit]
Description=BongoStock market gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bongostock
Group=bongostock
WorkingDirectory=/opt/bongostock-gateway
EnvironmentFile=/etc/bongostock-gateway.env
ExecStart=/usr/bin/node /opt/bongostock-gateway/dist/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bongostock-gateway
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
