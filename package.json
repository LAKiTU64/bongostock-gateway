{
  "name": "bongostock-gateway",
  "version": "0.1.0",
  "private": false,
  "description": "A small HTTPS-ready market gateway for BongoStock",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && node --watch dist/src/index.js",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/server.test.js dist-test/test/mxNews.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "stock-api": "2.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3"
  }
}
